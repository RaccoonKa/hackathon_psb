# Copy this file to .env and fill in real values before running.

# OpenAI-compatible LLM endpoint (config also supports OPENAI_BASE_URL / BASE_URL fallback)
LLM_BASE_URL=https://api.openai.com/v1
# Replace with your real API key (config also supports OPENAI_API_KEY / API_KEY fallback)
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_HISTORY_LIMIT=20

# Assistant backend implementation ("direct_llm" for Stage 1)
ASSISTANT_BACKEND=direct_llm

# Persistence & document corpus paths
DATABASE_URL=sqlite:///./storage/chat.db
DATA_DIR=./data

# Comma-separated allowed CORS origins for local frontend dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
