# =============================================================================
# Пример конфигурации проекта (шаблон, без реальных ключей и секретов).
# Скопируйте в .env и заполните своими значениями. .env НЕ коммитится.
#
# Режимы:
#   LOCAL  (settings_submit.USE_SUBMIT = False) — читается этот .env.
#   SUBMIT (settings_submit.USE_SUBMIT = True)  — .env не загружается;
#          значения приходят из окружения платформы.
#
# Все переменные читаются исключительно в src/config.py.
# Значения ниже — безопасные плейсхолдеры/дефолты, а не рабочие секреты.
# =============================================================================

# --- Локальные каталоги и рабочие пути ---------------------------------------
# DATA_DIR — каталог входных данных платформы (используется в SUBMIT).
#DATA_DIR=data
# SUBMIT_WORK_DIR — записываемый рабочий каталог в SUBMIT (по умолчанию временный).
#SUBMIT_WORK_DIR=

# --- Единый OpenAI-совместимый прокси: генерация -----------------------------
# Приоритет: LLM_BASE_URL -> OPENAI_BASE_URL -> OPENAI_API_BASE -> API_BASE_URL.
LLM_BASE_URL=https://api.example.invalid/v1
#LLM_API_BASE_URL=https://api.example.invalid/v1
#OPENAI_BASE_URL=https://api.example.invalid/v1
#OPENAI_API_BASE=https://api.example.invalid/v1
#API_BASE_URL=https://api.example.invalid/v1

# Ключ доступа к прокси. Никогда не коммитьте реальный ключ.
LLM_API_KEY=replace-with-your-api-key
#OPENAI_API_KEY=replace-with-your-api-key
#API_KEY=replace-with-your-api-key

# --- Модели ------------------------------------------------------------------
# Генеративная модель: LLM_MODEL -> OPENAI_MODEL -> GEN_MODEL.
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#GEN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# --- Эмбеддинги: llama.cpp как OpenAI-совместимый сервер ----------------------
# Локальный inference через transformers/torch больше не используется: клиент
# ходит в POST {EMBEDDING_API_BASE_URL}/embeddings. Поднимите сервер отдельно:
#   llama-server -m models/bge-m3/<gguf> --embedding --pooling cls \
#                --host 127.0.0.1 --port 8082 --alias bge-m3
EMBEDDING_API_BASE_URL=http://127.0.0.1:8082/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT=180
# L2-нормализация векторов (по умолчанию включена).
#EMBEDDING_NORMALIZE=true
# EMB_MODEL устарел (deprecated): приоритет всегда у EMBEDDING_MODEL.
#EMB_MODEL=bge-m3

# Реранкер.
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# Отдельные endpoint/ключ для реранкера (по умолчанию наследуются от API).
#RERANKER_API_BASE_URL=https://api.example.invalid/v1
#RERANKER_API_KEY=replace-with-your-api-key

# --- Параметры генерации и поиска --------------------------------------------
# Приоритет: TEMPERATURE -> LLM_TEMPERATURE; MAX_TOKENS -> LLM_MAX_TOKENS.
TEMPERATURE=0.0
MAX_TOKENS=1536
#TOP_K=10
#RAG_TOP_K=10
#RERANKER_TOP_N=5
#MAX_WORKERS=1
#CHUNKER=structural
#EMBEDDING_DIMENSION=1024
#RAG_SCORE_THRESHOLD=0.0
#REAL_RAG_DEFAULT_SCORE=1.0
#EMBED_BATCH_SIZE=16
#MAX_RETRIES=1

# --- Реранкер: таймауты и локальный запуск -----------------------------------
#RERANKER_TIMEOUT=30.0
#RERANKER_LOCAL_PATH=./models/Qwen3-Reranker-8B
#RERANKER_MAX_LENGTH=8192
#RERANKER_BATCH_SIZE=2

# --- RRF-fallback ------------------------------------------------------------
#RRF_FALLBACK_SCORE_CEILING=0.1
#RRF_FALLBACK_THRESHOLD=0.005

# --- Интент-классификатор ----------------------------------------------------
#INTENT_FALLBACK=semantic_query
#INTENT_CLASSIFIER_TEMPERATURE=0.0
#INTENT_CLASSIFIER_MAX_TOKENS=32

# --- Флаги режима (LOCAL). В SUBMIT принудительно выключены ------------------
#USE_STUB_RAG=false
#USE_STUB_RERANKER=false
#USE_STUB_LLM=false
#STUB_RAG_RETURN_EMPTY=false
#LLM_MODE=real
# USE_LOCAL_EMBEDDING_MODEL устарел (deprecated no-op): эмбеддинги всегда
# считает HTTP-сервер llama.cpp. ALLOW_HASH_FALLBACK по-прежнему управляет
# hash-fallback при недоступности сервера.
#USE_LOCAL_EMBEDDING_MODEL=true
#ALLOW_HASH_FALLBACK=true

# --- Бюджеты агентного пайплайна ---------------------------------------------
#MAX_LLM_FAILURES_PER_REQUEST=12
#MAX_LLM_FAILURES_PER_STEP=3
#MAX_ATTEMPTS_QUERY_ANALYSIS=2
#MAX_ATTEMPTS_GENERATE_INITIAL=2
#MAX_REGENERATE_CYCLES=1
#MAX_FOLLOWUP_RETRIEVAL_CYCLES=1
#LLM_REQUEST_TIMEOUT_S=30.0
#RETRIEVAL_TIMEOUT_S=20.0
#REQUEST_TOTAL_TIMEOUT_S=90.0

# --- Флаги проверок и памяти -------------------------------------------------
#ENABLE_MEMORY=false
#ENABLE_LLM_VERIFIER=true
#ENABLE_PREMISE_CHECK=true
#ENABLE_INJECTION_GUARD=true
#ENABLE_SANITY_CHECK_IN_ANALYSIS=false

# --- Явные размеры stub-ответов ----------------------------------------------
#STUB_PROMPT_TOKENS=128
#STUB_COMPLETION_TOKENS=64
