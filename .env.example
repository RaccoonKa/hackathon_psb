USE_STUB_RAG=false
USE_STUB_RERANKER=false
USE_STUB_LLM=false
LLM_MODE=real
ALLOW_HASH_FALLBACK=false

# DeepSeek: укажите свой токен и модель, доступную вашему провайдеру
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1536

# bge-m3: укажите свой токен и модель, доступную вашему провайдеру
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT=180

# Qwen3 Reranker: укажите свой токен и модель, доступную вашему провайдеру
RERANKER_API_BASE_URL=
