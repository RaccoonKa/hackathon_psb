# =============================================================================
# Пример конфигурации проекта (шаблон, без реальных ключей и секретов).
# Скопируйте в .env и заполните своими значениями. .env НЕ коммитится.
# =============================================================================

# --- Backend Application Configuration ---------------------------------------
# Варианты бэкенда: "rag" (полный пайплайн) или "direct_llm" (прямой вызов LLM)
ASSISTANT_BACKEND=rag

# База данных для истории чатов и сообщений
DATABASE_URL=sqlite:///./storage/chat.db

# Каталог входных документов
DATA_DIR=data

# Разрешенные CORS origins для фронтенда
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Лимит истории сообщений, передаваемой в контекст
LLM_HISTORY_LIMIT=20

# --- Единый OpenAI-совместимый прокси: генерация -----------------------------
LLM_BASE_URL=https://api.example.invalid/v1
# Ключ доступа к прокси. Никогда не коммитьте реальный ключ.
LLM_API_KEY=replace-with-your-api-key

# --- Модели ------------------------------------------------------------------
# Генеративная модель: LLM_MODEL -> OPENAI_MODEL -> GEN_MODEL
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Эмбеддинги: EMB_MODEL -> EMBEDDING_MODEL
EMB_MODEL=BAAI/bge-m3

# Реранкер
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# --- Параметры генерации и поиска --------------------------------------------
TEMPERATURE=0.0
MAX_TOKENS=1536
LLM_TIMEOUT_SECONDS=60

# --- Флаги режима (LOCAL) ---------------------------------------------------
# Локальные эмбеддинги и hash-fallback при недоступности API
USE_LOCAL_EMBEDDING_MODEL=false
ALLOW_HASH_FALLBACK=false

# Включение памяти диалога
ENABLE_MEMORY=true
